# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Real secrets (SMTP passwords, production DB URLs) never go in git.

# Postgres from docker-compose.yml, published on host port 5433.
# 127.0.0.1 rather than "localhost": on Windows "localhost" may resolve to IPv6 ::1
# first, and the container port is only bound on IPv4 loopback.
DATABASE_URL="postgresql://securewatch:securewatch@127.0.0.1:5433/securewatch"

# Everything below is optional; the values shown are the defaults.

# API server (port 3000 is taken on this machine, hence 4000). Docker uses HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=4000

# Scanning
# SCAN_CRON="0 */6 * * *"      # every 6 hours; a 6-field form adds seconds: "*/30 * * * * *"
# SCAN_CONCURRENCY=5           # how many domains are scanned at the same time
# SCAN_TIMEOUT_MS=10000        # limit for each network operation
# ALLOW_PRIVATE_TARGETS=false  # true lets scans reach private/internal addresses (SSRF risk)

# Alert emails. With no SMTP_HOST, development mode uses a throwaway Ethereal inbox:
# nothing is delivered, and the server log prints a link to view each email.
# For Mailtrap (or a real mail server) set these instead:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587                 # 587 = STARTTLS upgrade; 465 = TLS from the start (with SMTP_SECURE=true)
# SMTP_SECURE=false
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password
# ALERT_EMAIL_TO="you@example.com"     # required with SMTP_HOST; separate several with commas
# ALERT_EMAIL_FROM="SecureWatch <alerts@securewatch.local>"
# DASHBOARD_URL=http://localhost:5173  # alert emails link to the dashboard

# LOG_LEVEL=info
