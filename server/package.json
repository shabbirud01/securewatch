{
  "name": "securewatch-server",
  "version": "0.1.0",
  "private": true,
  "description": "SecureWatch API, scanner and scheduler",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:cert": "tsx src/scripts/checkCert.ts",
    "scan": "tsx src/scripts/scan.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "docx": "^9.12.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "jszip": "^3.10.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.6"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
